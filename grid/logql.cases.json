  "natural",
  "rawsql",
  "internal"
 ],
 "cases": [
  {
   "id": "count",
   "query": "count_over_time({log} [{r}])",
   "ranges": [
    "5m",
    "15m",
    "1h"
   ]
  },
  {
   "id": "count_by_l",
   "query": "sum by (l) (count_over_time({log} [{r}]))"
  },
  {
   "id": "rate",
   "query": "rate({log} [{r}])"
  },
  {
   "id": "rate_by_l",
   "query": "sum by (l) (rate({log} [{r}]))"
  },
  {
   "id": "bytes",
   "query": "bytes_over_time({log} [{r}])",
   "check": "shape",
   "note": "checked by series and timestamps only",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "bytes_rate",
   "query": "bytes_rate({log} [{r}])",
   "check": "shape",
   "note": "checked by series and timestamps only",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "sum_unwrap_by_l",
   "query": "sum by (l) (sum_over_time({log} | unwrap size [{r}]))",
   "stages": " | regexp \"size=(?P<size>[0-9]+)\"",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "avg_unwrap",
