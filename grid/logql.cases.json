   "stages": " | regexp \"size=(?P<size>[0-9]+)\"",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "min_unwrap",
   "query": "min_over_time({log} | unwrap size [{r}])",
   "stages": " | regexp \"size=(?P<size>[0-9]+)\"",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "max_unwrap",
   "query": "max_over_time({log} | unwrap size [{r}])",
   "stages": " | regexp \"size=(?P<size>[0-9]+)\"",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "max_unwrap_by_l",
   "query": "max_over_time({log} | unwrap size [{r}]) by (l)",
   "stages": " | regexp \"size=(?P<size>[0-9]+)\"",
   "paths": [
    "natural",
    "internal"
   ]
  },
  {
   "id": "quantile_unwrap",
   "query": "quantile_over_time(0.9, {log} | unwrap size [{r}])",
